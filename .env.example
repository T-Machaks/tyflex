# Copy to .env.local for local development. Never commit real values.

# ── Email transport ─────────────────────────────────────────────────────────
# Used by /api/contact, /api/quote, portal password resets and invoice sending.
# Microsoft Graph is preferred when all four GRAPH_* vars are set; otherwise
# AWS SES is used; otherwise submissions are logged to the console (dev only).

# Microsoft Graph / Exchange Online (app-only auth). Create an Azure AD app
# registration, add the Microsoft Graph *application* permission "Mail.Send",
# grant admin consent, then add a client secret. GRAPH_SENDER is a real
# licensed or shared mailbox in the tenant that the mail is sent as.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=no-reply@tyflex.co.zw

# AWS SES — alternative transport. On AWS, prefer granting ses:SendEmail via the
# compute role's IAM policy instead of the static keys below.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Verified SES sending identity (email or domain). Ignored when Graph is used.
SES_FROM_EMAIL=no-reply@tyflex.co.zw

# Inbox that receives lead notifications — used regardless of transport.
# Defaults to COMPANY.email (info@tyflex.co.zw) if unset.
SES_TO_EMAIL=info@tyflex.co.zw

# With no transport configured, /api/contact and /api/quote log submissions to
# the console instead of sending email — safe for local development.

# Anthropic — used by /api/chat for the streaming AI assistant widget (Claude Haiku 4.5).
# Without this set, /api/chat streams a canned demo reply instead of calling the API —
# safe for local development, but required in production.
ANTHROPIC_API_KEY=

# NextAuth — signs portal session tokens and the portal's own password-reset /
# local-download links. Required in production; falls back to an insecure
# placeholder outside production so `npm run dev` works with no setup.
NEXTAUTH_SECRET=
# Full deployed URL — NextAuth needs this in production for correct redirects.
NEXTAUTH_URL=https://tyflex.co.zw

# S3 — file storage for the document portal (/portal). Without AWS_REGION +
# S3_BUCKET_NAME set, admin uploads are written to a local .portal-uploads/
# directory instead (gitignored) and downloads are served through our own
# signed, expiring route — safe for local development, but S3 is required in
# production (the local fallback refuses to run there — see
# src/lib/portal/storage.ts).
S3_BUCKET_NAME=
